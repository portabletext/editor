{
  "plugins": ["react", "typescript", "unicorn", "oxc", "jsx-a11y", "vitest"],
  "jsPlugins": [
    {"name": "pte", "specifier": "./oxlint-plugins/no-weak-value-assertions.js"}
  ],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/lib/**",
    "**/coverage/**",
    "**/tsconfig.*.json"
  ],
  "overrides": [
    {
      "files": [
        "packages/**",
        "apps/playground/**",
        "apps/racetrack/**",
        "examples/basic/**"
      ],
      "rules": {
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/no-autofocus": ["error", {"ignoreNonDOM": true}],
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
        "jsx-a11y/no-noninteractive-tabindex": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/interactive-supports-focus": "error",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/mouse-events-have-key-events": "error",
        "jsx-a11y/media-has-caption": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/autocomplete-valid": "error",
        "jsx-a11y/lang": "error",

        "react/button-has-type": "error",
        "react/no-children-prop": "error",
        "react/no-render-return-value": "error",
        "react/void-dom-elements-no-children": "error",
        "react/jsx-key": "error",
        "react/no-array-index-key": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-target-blank": "error",
        "react/no-danger-with-children": "error",
        "react/rules-of-hooks": "error",

        "no-const-assign": "error",
        "no-constant-condition": "error",
        "no-constructor-return": "error",
        "no-empty-character-class": "error",
        "no-empty-pattern": "error",
        "no-obj-calls": "error",
        "no-inner-declarations": "error",
        "constructor-super": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-loss-of-precision": "error",
        "no-self-assign": "error",
        "no-setter-return": "error",
        "no-case-declarations": "error",
        "no-unreachable": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-optional-chaining": "error",
        "use-isnan": "error",
        "for-direction": "error",
        "valid-typeof": "error",
        "require-yield": "error",
        "no-async-promise-executor": "error",
        "no-class-assign": "error",
        "no-compare-neg-zero": "error",
        "no-control-regex": "error",
        "no-debugger": "error",
        "no-duplicate-case": "error",
        "no-dupe-class-members": "error",
        "no-dupe-else-if": "error",
        "no-dupe-keys": "error",
        "no-fallthrough": "error",
        "no-func-assign": "error",
        "no-global-assign": "error",
        "no-import-assign": "error",
        "no-label-var": "error",
        "no-misleading-character-class": "error",
        "no-redeclare": "error",
        "no-self-compare": "error",
        "no-shadow-restricted-names": "error",
        "no-sparse-arrays": "error",
        "no-unsafe-negation": "error",
        "no-with": "error",
        "getter-return": "error",
        "no-eval": "error",
        "no-new-native-nonconstructor": "error",
        "no-cond-assign": "error",
        "no-useless-escape": "error",
        "array-callback-return": "error",
        "no-console": ["error", {"allow": ["warn", "error"]}],
        "eqeqeq": ["error", "always", {"null": "ignore"}],
        "curly": "error",
        "prefer-const": "error",
        "prefer-template": "error",
        "require-await": "error",
        "no-unused-vars": [
          "error",
          {
            "args": "none",
            "caughtErrors": "none",
            "vars": "all",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ],

        "typescript/no-misused-new": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-empty-interface": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/consistent-type-imports": [
          "error",
          {"prefer": "type-imports", "disallowTypeAnnotations": false}
        ],

        "unicorn/no-thenable": "error",
        "oxc/misrefactored-assign-op": "error",
        "vitest/no-duplicate-hooks": "error",

        "pte/no-weak-value-assertions": "error"
      }
    },
    {
      "files": ["packages/editor/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "JSON",
            "message": "Use `safeStringify`/`safeParse` instead of `JSON.stringify`/`JSON.parse` to avoid crashes on circular references."
          }
        ],
        "object-shorthand": ["error", "always"]
      }
    },
    {
      "files": ["**/*.test-d.ts"],
      "rules": {
        "require-await": "off"
      }
    },
    {
      "files": ["packages/*/src/**", "apps/playground/src/**"],
      "excludeFiles": [
        "**/*.test.*",
        "**/__tests__/**",
        "packages/editor/src/engine/**"
      ],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/error-boundaries": "error",
        "react/globals": "error",
        "react/immutability": "error",
        "react/incompatible-library": "warn",
        "react/preserve-manual-memoization": "error",
        "react/purity": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/unsupported-syntax": "warn"
      }
    },
    {
      // Keep in lock-step with `reactCompiler.sources` (the
      // `COMPILED_SOURCES` constant) in `packages/editor/package.config.ts`.
      // These vendored engine files are un-excluded from BOTH the
      // react-compiler boundary and the react rules in tiers as the code is
      // audited safe.
      "files": [
        // Tier 1 = pure utilities (no hooks, no React, no module-level
        // mutation).
        "packages/editor/src/engine/path/path-equals.ts",
        "packages/editor/src/engine/path/parent-path.ts",
        "packages/editor/src/engine/text/text-equals.ts",
        "packages/editor/src/engine/text/get-text-decorations.ts",
        "packages/editor/src/engine/node/is-text-block-node.ts",
        "packages/editor/src/engine/node/is-object-node.ts",
        "packages/editor/src/engine/node/is-span-node.ts",
        "packages/editor/src/engine/editor/is-editor.ts",
        "packages/editor/src/engine/editor/start.ts",
        "packages/editor/src/engine/editor/end.ts",
        "packages/editor/src/engine/dom/utils/range-list.ts",
        "packages/editor/src/engine/dom/utils/environment.ts",
        "packages/editor/src/engine/react/utils/direction.ts",

        // Tier 2 = hook utilities. Phase 2 of the un-exclusion plan.
        "packages/editor/src/engine/react/hooks/use-engine-static.tsx",
        "packages/editor/src/engine/react/hooks/use-isomorphic-layout-effect.ts",
        "packages/editor/src/engine/react/hooks/use-generic-selector.tsx",
        "packages/editor/src/engine/react/hooks/use-read-only.ts",
        "packages/editor/src/engine/react/hooks/use-decorations.ts",
        "packages/editor/src/engine/react/hooks/use-decorations-by-child.ts",

        // Tier 3 = wrapper components rendered by `useChildren`.
        "packages/editor/src/engine/react/components/element.tsx",
        "packages/editor/src/engine/react/components/text.tsx",
        "packages/editor/src/engine/react/components/leaf.tsx",
        "packages/editor/src/engine/react/components/object-node.tsx",
        "packages/editor/src/engine/react/components/string.tsx"
      ],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/error-boundaries": "error",
        "react/globals": "error",
        "react/immutability": "error",
        "react/incompatible-library": "warn",
        "react/preserve-manual-memoization": "error",
        "react/purity": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/unsupported-syntax": "warn"
      }
    },
    {
      "files": ["examples/basic/src/**"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/error-boundaries": "error",
        "react/globals": "error",
        "react/immutability": "error",
        "react/incompatible-library": "warn",
        "react/preserve-manual-memoization": "error",
        "react/purity": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/unsupported-syntax": "warn",
        "react/only-export-components": ["warn", {"allowConstantExport": true}]
      }
    }
  ]
}
