{
  "name": "android-ime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:page": "vite build",
    "check:types": "tsc --noEmit --pretty --project tsconfig.json && tsc --noEmit --pretty --project tsconfig.page.json",
    "clean": "del .turbo && del .cache && del dist && del out && del node_modules",
    "test:device": "vitest run --project device",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@portabletext/editor": "workspace:*",
    "@portabletext/test": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vitejs/plugin-react": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24"
  }
}
