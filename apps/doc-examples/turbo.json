{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "check:types": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/src/content/docs/**/*.md",
        "$TURBO_ROOT$/apps/docs/src/content/docs/**/*.mdx",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/packages/*/src/**/*.ts",
        "$TURBO_ROOT$/packages/*/src/**/*.tsx"
      ]
    }
  }
}
