{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "./schemaTypes",
    "./scripts",
    "./e2e",
    "./sanity.config.ts",
    "./sanity.cli.ts",
    "./playwright.config.ts"
  ]
}
