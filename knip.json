{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@types/react", "@types/react-dom", "@types/react-is"],
  "ignore": ["oxlint-plugins/**", "packages/*/bundle-tests/**"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts!", "package.config.ts!"],
      "ignoreDependencies": [
        "oxc-transform-react",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-v8",
        "@vitest/coverage-istanbul",
        "vite"
      ]
    },
    "packages/editor": {
      "entry": [
        "src/index.ts!",
        "src/behaviors/_exports/index.ts!",
        "src/plugins/_exports/index.ts!",
        "src/selectors/_exports/index.ts!",
        "src/test/_exports/index.ts!",
        "src/test/vitest/_exports/index.ts!",
        "src/utils/_exports/index.ts!",
        "package.config.ts!",
        "vitest.android.config.ts",
        "android/vite.config.ts",
        "android/page/editor.tsx",
        "android/scripts/fixtures/suites/*.ts"
      ],
      "ignoreDependencies": [
        "oxc-transform-react",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-v8",
        "@vitest/coverage-istanbul",
        "vite"
      ]
    },
    "packages/html": {
      "entry": [
        "src/index.ts!",
        "src/rules/index.ts!",
        "src/tests/snapshot-tests/*/index.ts",
        "package.config.ts!"
      ],
      "ignoreDependencies": [
        "oxc-transform-react",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-v8",
        "@vitest/coverage-istanbul",
        "vite"
      ]
    },
    "apps/*": {
      "ignoreDependencies": [
        "oxc-transform-react",
        "tailwindcss-react-aria-components",
        "sharp"
      ]
    },
    "packages/thumbjar": {
      "entry": [
        "src/index.ts!",
        "src/page.ts!",
        "src/vitest/index.ts!",
        "src/vitest/global-setup.ts!",
        "src/vitest/setup.ts!",
        "src/bin.ts!",
        "src/prepare/*.ts!",
        "src/run/*.ts!",
        "package.config.ts!",
        "src/device/*.ts",
        "src/gboard/*.ts",
        "src/fixtures/suites/*.ts"
      ]
    },
    "apps/studio": {
      "ignoreDependencies": [
        "@portabletext/block-tools",
        "@portabletext/editor",
        "@portabletext/html",
        "@portabletext/patches",
        "@portabletext/plugin-dnd",
        "@portabletext/plugin-list-index",
        "@portabletext/plugin-markdown-shortcuts",
        "@portabletext/plugin-one-line",
        "@portabletext/plugin-paste-link",
        "@portabletext/plugin-table",
        "@portabletext/plugin-typography",
        "@portabletext/sanity-bridge"
      ]
    },
    "apps/doc-examples": {
      "ignoreDependencies": [
        "@portabletext/block-tools",
        "@portabletext/editor",
        "@portabletext/html",
        "@portabletext/keyboard-shortcuts",
        "@portabletext/markdown",
        "@portabletext/patches",
        "@portabletext/plugin-character-pair-decorator",
        "@portabletext/plugin-decorations",
        "@portabletext/plugin-dnd",
        "@portabletext/plugin-emoji-picker",
        "@portabletext/plugin-input-rule",
        "@portabletext/plugin-list-index",
        "@portabletext/plugin-markdown-shortcuts",
        "@portabletext/plugin-one-line",
        "@portabletext/plugin-paste-link",
        "@portabletext/plugin-sdk-value",
        "@portabletext/plugin-table",
        "@portabletext/plugin-typeahead-picker",
        "@portabletext/plugin-typography",
        "@portabletext/react",
        "@portabletext/repair",
        "@portabletext/sanity-bridge",
        "@portabletext/schema",
        "@portabletext/test",
        "@portabletext/to-html",
        "@portabletext/toolbar",
        "@sanity/asset-utils",
        "@sanity/image-url",
        "@sanity/schema",
        "@sanity/types",
        "@vitest/browser-playwright",
        "emojilib",
        "racejar",
        "react",
        "thumbjar",
        "vitest"
      ]
    },
    "examples/*": {},
    ".": {
      "entry": ["bundle-stats.config.ts", "build-config/*.d.ts"],
      "ignoreDependencies": ["@playwright/test"]
    }
  }
}
