    {
      "type": "insert",
      "path": [
        {
          "_key": "k0"
        },
        "children",
        {
          "_key": "k1"
        }
      ],
      "position": "after",
      "items": [
        {
          "_key": "k5",
          "_type": "span",
          "marks": [],
          "text": " baz"
        }
      ],
      "origin": "local"
    },
    {
      "type": "diffMatchPatch",
      "path": [
        {
          "_key": "k0"
        },
        "children",
        {
          "_key": "k1"
        },
        "text"
      ],
      "value": "@@ -1,7 +1,4 @@\n foo \n-bar\n",
