{
  "name": "@portabletext/io",
  "version": "0.0.0",
  "private": true,
  "description": "A model of the editor I/O protocol, tested with Gherkin scenarios",
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "check:types": "tsc",
    "check:types:watch": "tsc --watch",
    "clean": "del .turbo && del node_modules",
    "test:unit": "vitest --run --project unit",
    "test:unit:watch": "vitest --project unit"
  },
  "dependencies": {
    "@portabletext/patches": "workspace:^",
    "@portabletext/schema": "workspace:^",
    "@portabletext/test": "workspace:^"
  },
  "devDependencies": {
    "@sanity/tsconfig": "catalog:tooling",
    "racejar": "workspace:*",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=22.12"
  }
}
